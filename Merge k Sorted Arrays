class Solution {
    public ArrayList<Integer> mergeArrays(int[][] mat) {
        // Code here
        class node
        {
            int value;
            int row;
            int col;
            
            node(int value,int row,int col)
            {
                this.value=value;
                this.row =row;
                this.col=col;
                
            }
        }
        ArrayList<Integer> ans =  new ArrayList<>();
        PriorityQueue<node> pq = new PriorityQueue<>((a,b)->a.value-b.value);
      for(int i =0;i<mat.length;i++)
      {
        pq.offer(new node(mat[i][0],i,0));
      }
      while(!pq.isEmpty())
     {
         node extract = pq.poll();
         ans.add(extract.value);
       if (extract.col + 1 < mat[0].length)
         {
      
        node next=new node(mat[extract.row][extract.col+1],
         extract.row,
         extract.col+1);
          pq.offer(next);
         }
        
      }
      return ans;
      
        
    }
}
